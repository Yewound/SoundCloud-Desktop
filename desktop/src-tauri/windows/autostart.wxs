<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Fragment>
        <ComponentGroup Id="AutostartCleanup" />

        <Property Id="WixQuietExecCmdLine" Value="&quot;[SystemFolder]cmd.exe&quot; /d /c (for %k in (Run Explorer\StartupApproved\Run) do for %v in (soundcloud-desktop &quot;SoundCloud Desktop&quot;) do reg delete HKCU\Software\Microsoft\Windows\CurrentVersion\%k /v %v /f) &amp; exit 0" />

        <CustomAction Id="RemoveAutostart" BinaryKey="WixCA" DllEntry="WixQuietExec" Execute="immediate" Return="ignore" />

        <InstallExecuteSequence>
            <Custom Action="RemoveAutostart" After="InstallFinalize">(REMOVE = "ALL") AND NOT UPGRADINGPRODUCTCODE</Custom>
        </InstallExecuteSequence>
    </Fragment>
</Wix>
